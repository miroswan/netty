<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.netty</groupId>
    <artifactId>netty5-parent</artifactId>
    <version>5.0.0.Final-SNAPSHOT</version>
  </parent>

  <artifactId>netty5-benchmarks</artifactId>
  <packaging>jar</packaging>

  <name>Netty/Benchmarks</name>

  <properties>
    <skipTests>true</skipTests>
    <kqueue.classifier />
    <revapi.skip>true</revapi.skip>

    <benchmark.iterations>5</benchmark.iterations>
    <benchmark.connections>100</benchmark.connections>
    <benchmark.duration>60s</benchmark.duration>
    <benchmark.warmupDuration>2000</benchmark.warmupDuration>
    <benchmark.qps>0</benchmark.qps>
    <benchmark.payload>hello</benchmark.payload>
    <benchmark.label>unnamed</benchmark.label>
  </properties>

  <profiles>
    <profile>
      <id>mac</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <kqueue.classifier>${jni.classifier}</kqueue.classifier>
      </properties>
    </profile>

    <profile>
      <id>benchmark-suite</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.0</version>
            <configuration>
              <mainClass>io.netty.benchmarks.loadtest.LoadTestOrchestrator</mainClass>
              <arguments>
                <argument>suite</argument>
              </arguments>
              <systemProperties>
                <systemProperty>
                  <key>benchmark.label</key>
                  <value>${benchmark.label}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.iterations</key>
                  <value>${benchmark.iterations}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.connections</key>
                  <value>${benchmark.connections}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.duration</key>
                  <value>${benchmark.duration}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.warmupDuration</key>
                  <value>${benchmark.warmupDuration}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.qps</key>
                  <value>${benchmark.qps}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.payload</key>
                  <value>${benchmark.payload}</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>benchmark-quick</id>
      <properties>
        <benchmark.iterations>1</benchmark.iterations>
        <benchmark.duration>30s</benchmark.duration>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.0</version>
            <configuration>
              <mainClass>io.netty.benchmarks.loadtest.LoadTestOrchestrator</mainClass>
              <arguments>
                <argument>suite</argument>
              </arguments>
              <systemProperties>
                <systemProperty>
                  <key>benchmark.label</key>
                  <value>${benchmark.label}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.iterations</key>
                  <value>${benchmark.iterations}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.connections</key>
                  <value>${benchmark.connections}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.duration</key>
                  <value>${benchmark.duration}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.warmupDuration</key>
                  <value>${benchmark.warmupDuration}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.qps</key>
                  <value>${benchmark.qps}</value>
                </systemProperty>
                <systemProperty>
                  <key>benchmark.payload</key>
                  <value>${benchmark.payload}</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>benchmark-compare</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.1.0</version>
            <configuration>
              <mainClass>io.netty.benchmarks.loadtest.LoadTestOrchestrator</mainClass>
              <arguments>
                <argument>compare</argument>
              </arguments>
              <systemProperties>
                <systemProperty>
                  <key>baseline.label</key>
                  <value>${baseline.label}</value>
                </systemProperty>
                <systemProperty>
                  <key>candidate.label</key>
                  <value>${candidate.label}</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>netty5-transport</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>netty5-transport-classes-kqueue</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>netty5-transport-native-kqueue</artifactId>
      <version>${project.version}</version>
      <classifier>${kqueue.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>netty5-ffm</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>netty5-codec-http</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>netty5-handler</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-math3</artifactId>
      <version>3.6.1</version>
    </dependency>
  </dependencies>
</project>
